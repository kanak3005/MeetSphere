# Server
PORT=5000
NODE_ENV=development

# Frontend
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/meetsphere
JWT_SECRET=replace_with_a_secure_random_secret

# JWT - Access Token
ACCESS_TOKEN_SECRET=PASTE_YOUR_NEW_ACCESS_SECRET_HERE
ACCESS_TOKEN_EXPIRY=15m

# JWT - Refresh Token
REFRESH_TOKEN_SECRET=PASTE_YOUR_NEW_REFRESH_SECRET_HERE
REFRESH_TOKEN_EXPIRY=7d